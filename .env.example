# ── Banco (Neon) ──
# Connection string do MESMO banco Neon em que está teste7d_inscricoes,
# com o usuário painel_app (criado à parte; permissões no fim de
# db/migrations/20261028_painel_base.sql). Obrigatória.
#   postgres://painel_app:SENHA@ep-xxxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── Login (Better Auth) ──
# Segredo que assina os cookies de sessão e criptografa os tokens do Google
# guardados no banco. Mínimo 32 caracteres, aleatório:
#   openssl rand -base64 48
# Trocar derruba todas as sessões abertas.
AUTH_SECRET=

# Origem pública do painel, sem barra no fim. É a base dos links mágicos e
# do retorno do Google, e a única origem aceita nos POSTs de login.
# Produção: https://painel.useady.com.br  ·  Local: http://localhost:3000
# (Prefixo NEXT_PUBLIC: entra no build; trocar exige novo deploy.)
NEXT_PUBLIC_APP_URL=

# Google OAuth (Google Cloud Console > APIs e serviços > Credenciais >
# ID do cliente OAuth, tipo "Aplicativo da Web"). URIs de redirecionamento
# autorizados a cadastrar:
#   https://painel.useady.com.br/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (só se for testar local)
# Origens JavaScript autorizadas: https://painel.useady.com.br
# Tela de consentimento: tipo "Externo" (parte da equipe não é do Workspace).
# Sem as duas variáveis, o botão "Entrar com Google" some e só o link
# mágico funciona. O Google só prova o e-mail; quem entra continua sendo
# decidido pela tabela painel_usuarios (nunca por domínio).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── E-mail do link mágico (SendGrid) ──
# Chave da API v3 com permissão "Mail Send". Obrigatória na Vercel.
SENDGRID_API_KEY=
# Remetente verificado no SendGrid (Single Sender ou domínio autenticado),
# ex. painel@useady.com.br. O nome exibido é "painel ady".
EMAIL_FROM=

# ── Primeiro admin ──
# E-mail que vira admin na PRIMEIRA tentativa de login, e só se
# painel_usuarios estiver vazia. Depois disso não faz mais nada (pode
# ficar ou ser apagada). Os demais usuários são criados na tela Usuários.
PAINEL_ADMIN_INICIAL=

# ── Só desenvolvimento e testes (NUNCA na Vercel; lá são ignoradas) ──
# "pg" troca o driver do Neon pelo `pg` pra falar com o Postgres local do
# docker-compose.yml (npm run db:up). Com ela, DATABASE_URL fica:
#   postgres://postgres:postgres@localhost:54329/painel
DATABASE_DRIVER=
# Sem SENDGRID_API_KEY, os e-mails viram arquivos .json nesta pasta (ex.
# .dev-emails); sem as duas, o link aparece no console do `next dev`.
PAINEL_DEV_EMAIL_DIR=
